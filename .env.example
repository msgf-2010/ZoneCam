DATABASE_URL="file:./dev.db"
# AUTH_SECRET must be at least 32 characters in production. Never ship the dev placeholder.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
APP_URL="http://localhost:3001"
# Extra browser origins (comma-separated). Android emulator uses http://10.0.2.2:3001 automatically in development.
# ALLOWED_ORIGINS="http://10.0.2.2:3001"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MEDIA_MAX_BYTES="83886080"
# Production on Cloudflare: STORAGE_DRIVER=r2 plus the R2_* values. See docs/DEPLOY.md.
# TRUST_CLOUDFLARE="true"
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# S3 / Azure remain unconnected until implemented
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_KEY=
EMAIL_DRIVER="console"
JOBS_DRIVER="inline"
AI_DRIVER="internal"
PAYMENTS_DRIVER="internal"
SEARCH_DRIVER="sql"
REALTIME_DRIVER="memory"
