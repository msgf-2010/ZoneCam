generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarKey       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  memberships              CompanyMembership[]
  sessions                 Session[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  assignedTasks            Task[]                   @relation("TaskAssignee")
  createdTasks             Task[]                   @relation("TaskCreator")
  comments                 Comment[]
  timelineEvents           TimelineEvent[]
  uploadedMedia            Media[]                  @relation("MediaUploader")
  annotations              MediaAnnotation[]
  projectMemberships       ProjectMember[]
  teamMemberships          TeamMember[]
  notes                    ProjectNote[]
  signaturesRequested      Signature[]              @relation("SignatureRequester")
}

model Company {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  timezone  String    @default("America/New_York")
  logoKey   String?
  settings  String    @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships             CompanyMembership[]
  roles                   Role[]
  teams                   Team[]
  customers               Customer[]
  projectTypes            ProjectType[]
  projectStatuses         ProjectStatus[]
  projects                Project[]
  media                   Media[]
  mediaFolders            MediaFolder[]
  mediaTags               MediaTag[]
  timelineEvents          TimelineEvent[]
  projectNotes            ProjectNote[]
  comments                Comment[]
  taskLists               TaskList[]
  tasks                   Task[]
  checklistTemplates      ChecklistTemplate[]
  checklists              Checklist[]
  reports                 Report[]
  reportTemplates         ReportTemplate[]
  signatures              Signature[]
  payments                Payment[]
  notifications           Notification[]
  integrations            Integration[]
  auditLogs               AuditLog[]
  sessions                Session[]
  invites                 CompanyInvite[]
}

model CompanyMembership {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  roleId    String
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, status])
}

enum MembershipStatus {
  invited
  active
  disabled
}

model CompanyInvite {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  roleId     String
  tokenHash  String    @unique
  invitedById String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, email])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships CompanyMembership[]

  @@unique([companyId, key])
  @@index([companyId])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  category    String
  description String @default("")

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Team {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@index([companyId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  companyId        String?
  tokenHash        String   @unique
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  customerNumber String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts CustomerContact[]
  projects Project[]
  payments Payment[]

  @@unique([companyId, customerNumber])
  @@index([companyId, name])
}

model CustomerContact {
  id         String    @id @default(cuid())
  companyId  String
  customerId String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([companyId, customerId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model ProjectType {
  id        String   @id @default(cuid())
  companyId String
  key       String
  name      String
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([companyId, key])
}

model ProjectStatus {
  id         String   @id @default(cuid())
  companyId  String
  key        String
  name       String
  color      String   @default("#64748b")
  sortOrder  Int      @default(0)
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([companyId, key])
}

model Project {
  id                      String    @id @default(cuid())
  companyId               String
  customerId              String?
  customerContactId       String?
  projectTypeId           String?
  projectStatusId         String
  name                    String
  number                  String
  description             String    @default("")
  internalNotes           String    @default("")
  customerNotes           String    @default("")
  addressLine1            String?
  addressLine2            String?
  city                    String?
  region                  String?
  postalCode              String?
  country                 String?
  latitude                Float?
  longitude               Float?
  startDate               DateTime?
  expectedCompletionDate  DateTime?
  completedAt             DateTime?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  projectType     ProjectType?     @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  projectStatus   ProjectStatus    @relation(fields: [projectStatusId], references: [id])
  members         ProjectMember[]
  locations       ProjectLocation[]
  media           Media[]
  folders         MediaFolder[]
  timelineEvents  TimelineEvent[]
  notes           ProjectNote[]
  comments        Comment[]
  taskLists       TaskList[]
  tasks           Task[]
  checklists      Checklist[]
  reports         Report[]
  signatures      Signature[]
  payments        Payment[]

  @@unique([companyId, number])
  @@index([companyId, projectStatusId])
  @@index([companyId, customerId])
  @@index([companyId, startDate])
}

model ProjectMember {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([companyId, userId])
}

model ProjectLocation {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String
  label        String   @default("Primary")
  addressLine1 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  latitude     Float?
  longitude    Float?
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaFolder {
  id        String    @id @default(cuid())
  companyId String
  projectId String?
  parentId  String?
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent  MediaFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderTree")
  media   Media[]

  @@index([companyId, projectId])
}

model Media {
  id                String          @id @default(cuid())
  companyId         String
  projectId         String?
  folderId          String?
  taskId            String?
  type              MediaType
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  width             Int?
  height            Int?
  durationMs        Int?
  storageKey        String
  thumbnailKey      String?
  previewKey        String?
  description       String          @default("")
  capturedAt        DateTime?
  latitude          Float?
  longitude         Float?
  processingStatus  ProcessingStatus @default(pending)
  processingError   String?
  uploadedById      String?
  clientUploadId    String?
  uploadStatus      String           @default("stored")
  deviceInfo        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder      MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy  User?             @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  tags        MediaTagOnMedia[]
  annotations MediaAnnotation[]
  walkthroughChecklists Checklist[]     @relation("WalkthroughSourceMedia")
  checklistScreenshots  ChecklistItem[] @relation("ChecklistItemScreenshot")

  @@index([companyId, projectId, createdAt])
  @@index([companyId, processingStatus])
  @@index([storageKey])
  @@unique([companyId, clientUploadId])
}

enum MediaType {
  photo
  video
  file
}

enum ProcessingStatus {
  pending
  processing
  ready
  failed
}

model MediaTag {
  id        String @id @default(cuid())
  companyId String
  name      String

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  media   MediaTagOnMedia[]

  @@unique([companyId, name])
}

model MediaTagOnMedia {
  mediaId String
  tagId   String

  media Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   MediaTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

model MediaAnnotation {
  id          String   @id @default(cuid())
  companyId   String
  mediaId     String
  createdById String?
  // Structured overlay JSON: never mutates the original object bytes.
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media     Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, mediaId])
}

// ---------------------------------------------------------------------------
// Timeline, notes, comments
// ---------------------------------------------------------------------------

model TimelineEvent {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String?
  actorUserId  String?
  type         String
  description  String
  entityType   String?
  entityId     String?
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId, createdAt])
  @@index([companyId, type])
}

model ProjectNote {
  id          String    @id @default(cuid())
  companyId   String
  projectId   String
  authorId    String?
  body        String
  visibility  Visibility @default(internal)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId, createdAt])
}

enum Visibility {
  internal
  customer
}

model Comment {
  id          String     @id @default(cuid())
  companyId   String
  projectId   String?
  authorId    String?
  body        String
  visibility  Visibility @default(internal)
  parentType  String
  parentId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  mentions Mention[]

  @@index([companyId, parentType, parentId])
  @@index([companyId, projectId, createdAt])
}

model Mention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

// ---------------------------------------------------------------------------
// Tasks & checklists
// ---------------------------------------------------------------------------

model TaskList {
  id          String    @id @default(cuid())
  companyId   String
  projectId   String?
  name        String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([companyId, projectId])
}

model Task {
  id           String     @id @default(cuid())
  companyId    String
  projectId    String?
  taskListId   String?
  parentTaskId String?
  title        String
  description  String     @default("")
  status       TaskStatus @default(open)
  priority     TaskPriority @default(normal)
  dueAt        DateTime?
  assigneeId   String?
  createdById  String?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskList   TaskList? @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  parent     Task?     @relation("TaskTree", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children   Task[]    @relation("TaskTree")
  assignee   User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items      TaskItem[]
  media      Media[]

  @@index([companyId, projectId, status])
  @@index([companyId, assigneeId, dueAt])
}

enum TaskStatus {
  open
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

model TaskItem {
  id          String    @id @default(cuid())
  companyId   String
  taskId      String
  title       String
  isComplete  Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   ChecklistTemplateItem[]
  checklists Checklist[]

  @@index([companyId])
}

model ChecklistTemplateItem {
  id         String @id @default(cuid())
  templateId String
  title      String
  sortOrder  Int    @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Checklist {
  id            String    @id @default(cuid())
  companyId     String
  projectId     String?
  templateId    String?
  name          String
  source        String    @default("manual")
  summary       String    @default("")
  sourceMediaId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template    ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourceMedia Media?             @relation("WalkthroughSourceMedia", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  items       ChecklistItem[]

  @@index([companyId, projectId])
  @@index([sourceMediaId])
}

model ChecklistItem {
  id                 String    @id @default(cuid())
  companyId          String
  checklistId        String
  title              String
  isComplete         Boolean   @default(false)
  completedAt        DateTime?
  sortOrder          Int       @default(0)
  trade              String    @default("")
  notes              String    @default("")
  timestampMs        Int?
  screenshotMediaId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  checklist  Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  screenshot Media?    @relation("ChecklistItemScreenshot", fields: [screenshotMediaId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([screenshotMediaId])
}

// ---------------------------------------------------------------------------
// Reports, signatures, payments
// ---------------------------------------------------------------------------

model ReportTemplate {
  id        String   @id @default(cuid())
  companyId String
  key       String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections ReportSection[]
  reports  Report[]

  @@unique([companyId, key])
}

model ReportSection {
  id         String @id @default(cuid())
  templateId String
  key        String
  title      String
  sortOrder  Int    @default(0)
  config     String @default("{}")

  template ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Report {
  id            String       @id @default(cuid())
  companyId     String
  projectId     String?
  templateId    String?
  title         String
  status        ReportStatus @default(draft)
  shareTokenHash String?     @unique
  body          String       @default("{}")
  generatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template   ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signatures Signature[]

  @@index([companyId, projectId])
}

enum ReportStatus {
  draft
  generated
  shared
  signed
}

model Signature {
  id              String          @id @default(cuid())
  companyId       String
  projectId       String?
  reportId        String?
  requestedById   String?
  signerName      String
  signerEmail     String
  status          SignatureStatus @default(pending)
  signedAt        DateTime?
  signatureKey    String?
  ipAddress       String?
  userAgent       String?
  provider        String          @default("internal")
  providerRef     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  report      Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("SignatureRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([companyId, projectId, status])
}

enum SignatureStatus {
  pending
  signed
  declined
  cancelled
}

model Payment {
  id                    String        @id @default(cuid())
  companyId             String
  projectId             String?
  customerId            String?
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(draft)
  provider              String        @default("internal")
  providerTransactionId String?
  shareTokenHash        String?       @unique
  payerName             String        @default("")
  payerEmail            String        @default("")
  description           String        @default("")
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, projectId])
}

enum PaymentStatus {
  draft
  requested
  processing
  paid
  failed
  cancelled
  refunded
}

// ---------------------------------------------------------------------------
// Notifications, integrations, audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String
  title     String
  body      String    @default("")
  entityType String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([companyId, createdAt])
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  eventType String
  inApp     Boolean @default(true)
  email     Boolean @default(true)
  push      Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}

model Integration {
  id        String            @id @default(cuid())
  companyId String
  provider  String
  status    IntegrationStatus @default(not_configured)
  settings  String            @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credentials IntegrationCredential[]
  logs        IntegrationLog[]

  @@unique([companyId, provider])
}

enum IntegrationStatus {
  not_configured
  connected
  error
  disconnected
}

model IntegrationCredential {
  id            String    @id @default(cuid())
  integrationId String
  encryptedPayload String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  level         String
  message       String
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}
