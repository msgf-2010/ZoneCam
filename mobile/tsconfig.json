{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "moduleSuffixes": [".ios", ".android", ".native", ".web", ""],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "App.tsx"
  ],
  "extends": "expo/tsconfig.base"
}
